{
  "name": "phoneix",
  "version": "0.1.1",
  "description": "Phoneix: Android phone link for Windows (notifications, files, screen)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "license": "MIT",
  "dependencies": {
    "koffi": "^3.3.3",
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "^26.15.3"
  },
  "author": "Ahmet Efe Korkmaz",
  "build": {
    "appId": "com.phoneix.desktop",
    "productName": "Phoneix",
    "directories": {
      "output": "dist"
    },
    "files": [
      "*.js",
      "*.html",
      "assets/**",
      "!assets/make-icon.js",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
